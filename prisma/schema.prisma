// =============================================
// BETTER AUTH МОДЕЛІ (залишаємо без змін)
// admin, manager, cleaner, accountant
// =============================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("user")
  phone         String?
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdOrders   Order[]   @relation("CreatedOrders")
  assignedOrders  Order[]   @relation("AssignedCleaner")

  // НОВІ зв'язки
  workerOrders    OrderWorker[]       @relation("WorkerOrders")
  expenses        Expense[]           @relation("UserExpenses")
  createdExpenses Expense[]           @relation("CreatedExpenses")
  workerStats     WorkerMonthlyStat[]

  sessions        Session[]
  accounts        Account[]
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Account {
  id                        String    @id @default(cuid())
  userId                    String
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId                 String
  providerId                String
  accessToken               String?
  refreshToken              String?
  accessTokenExpiresAt      DateTime?
  refreshTokenExpiresAt     DateTime?
  scope                     String?
  idToken                   String?
  password                  String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// =============================================
// МОДЕЛІ ДЛЯ КЛІНІНГОВОЇ CRM
// =============================================

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum CleaningType {
  REGULAR
  GENERAL
  AFTER_REPAIR
  OFFICE
  DEEP_CLEAN
  CARPET
  WINDOW
  OTHER
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]
  orders     Order[]
}

enum PropertyType {
  APARTMENT
  HOUSE
  OFFICE
  COMMERCIAL
  OTHER
}

model Property {
  id         String       @id @default(cuid())
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  street     String
  apt        String?
  floor      Int?
  city       String       @default("Київ")

  type       PropertyType @default(APARTMENT)
  area       Int?
  rooms      Int?
  notes      String?

  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

model CleaningService {
  id          String       @id @default(cuid())
  name        String       @unique
  type        CleaningType
  basePrice   Decimal      @db.Decimal(10, 2)
  duration    Int?
  description String?
  isActive    Boolean      @default(true)

  orderItems  OrderItem[]
}

model Order {
  id                  String        @id @default(cuid())
  createdAt           DateTime      @default(now())
  scheduledDate       DateTime

  status              OrderStatus   @default(PENDING)
  paymentStatus       PaymentStatus @default(UNPAID)

  customerId          String
  customer            Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  propertyId          String
  property            Property      @relation(fields: [propertyId], references: [id])

  cleanerId           String?
  cleaner             User?         @relation("AssignedCleaner", fields: [cleanerId], references: [id])

  totalAmount         Decimal       @db.Decimal(10, 2)
  paidAmount          Decimal       @default(0) @db.Decimal(10, 2)

  notes               String?
  createdById         String
  createdBy           User          @relation("CreatedOrders", fields: [createdById], references: [id])

  reminder1DaySent    Boolean       @default(false)
  reminder3HoursSent  Boolean       @default(false)

  items               OrderItem[]
  reminders           ReminderLog[]

  // НОВІ зв'язки
  workers             OrderWorker[]
  expenses            Expense[]
  payments            Payment[]
}

model OrderItem {
  id         String          @id @default(cuid())
  orderId    String
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  serviceId  String
  service    CleaningService @relation(fields: [serviceId], references: [id])

  qty        Int             @default(1)
  price      Decimal         @db.Decimal(10, 2)
}

model ReminderLog {
  id              String         @id @default(cuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  type            String
  sentAt          DateTime       @default(now())
  status          ReminderStatus @default(SENT)
  telegramChatId  String?
  error           String?

  @@index([orderId, type])
}

// =============================================
// НОВІ МОДЕЛІ: ПЕРСОНАЛ НА ЗАМОВЛЕННІ
// =============================================

// Хто саме працював на конкретному замовленні,
// скільки годин і скільки йому заплатили
model OrderWorker {
  id          String   @id @default(cuid())

  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  userId      String
  user        User     @relation("WorkerOrders", fields: [userId], references: [id])

  role        String?          // "старший", "помічник" тощо
  hoursWorked Decimal?         @db.Decimal(4, 1)
  workerPay   Decimal?         @db.Decimal(10, 2)
  note        String?

  @@unique([orderId, userId])
  @@index([userId])
}

// =============================================
// НОВІ МОДЕЛІ: ВИТРАТИ
// =============================================

enum ExpenseType {
  SALARY        // Зарплата / аванс
  SUPPLY        // Засоби, витратники, хімія
  TRANSPORT     // Транспорт, паливо
  EQUIPMENT     // Обладнання, інвентар
  MARKETING     // Реклама
  RENT          // Оренда офісу / складу
  OTHER
}

model ExpenseCategory {
  id       String      @id @default(cuid())
  name     String      @unique
  type     ExpenseType

  expenses Expense[]
}

// Витрата — прив'язана до замовлення (orderId) або загальна (orderId = null)
model Expense {
  id          String           @id @default(cuid())
  amount      Decimal          @db.Decimal(10, 2)
  date        DateTime         @default(now())
  description String?

  categoryId  String
  category    ExpenseCategory  @relation(fields: [categoryId], references: [id])

  // Прив'язка до замовлення (необов'язково)
  orderId     String?
  order       Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // Прив'язка до співробітника (необов'язково, напр. виплата зарплати)
  userId      String?
  user        User?            @relation("UserExpenses", fields: [userId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User             @relation("CreatedExpenses", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())

  @@index([date])
  @@index([orderId])
  @@index([userId])
}

// =============================================
// НОВІ МОДЕЛІ: ПЛАТЕЖІ
// =============================================

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

// Фіксація кожного факту оплати по замовленню
// (дозволяє часткові оплати та різні методи)
model Payment {
  id       String        @id @default(cuid())

  orderId  String
  order    Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amount   Decimal       @db.Decimal(10, 2)
  method   PaymentMethod @default(CASH)
  paidAt   DateTime      @default(now())
  note     String?

  @@index([orderId])
  @@index([paidAt])
}

// =============================================
// НОВІ МОДЕЛІ: АНАЛІТИКА (кеш для дашборду)
// =============================================

// Денна статистика — оновлюється при кожній зміні
// замовлення, платежу або витрати за цей день
model DailyStat {
  id           String   @id @default(cuid())
  date         DateTime @unique // зберігаємо як початок дня: 2025-01-15T00:00:00Z

  ordersCount  Int      @default(0)   // кількість замовлень за день
  revenue      Decimal  @default(0)   @db.Decimal(12, 2) // сума платежів
  expenses     Decimal  @default(0)   @db.Decimal(12, 2) // сума витрат
  profit       Decimal  @default(0)   @db.Decimal(12, 2) // revenue - expenses

  updatedAt    DateTime @updatedAt

  @@index([date])
}

// Місячна статистика
model MonthlyStat {
  id            String  @id @default(cuid())
  year          Int
  month         Int     // 1–12

  ordersCount   Int     @default(0)
  revenue       Decimal @default(0) @db.Decimal(12, 2)
  expenses      Decimal @default(0) @db.Decimal(12, 2)
  profit        Decimal @default(0) @db.Decimal(12, 2)
  workerPayroll Decimal @default(0) @db.Decimal(12, 2) // загальний ФОП за місяць

  updatedAt     DateTime @updatedAt

  @@unique([year, month])
  @@index([year, month])
}

// Статистика по кожному прибиральнику за місяць
model WorkerMonthlyStat {
  id          String  @id @default(cuid())

  userId      String
  user        User    @relation(fields: [userId], references: [id])

  year        Int
  month       Int

  ordersCount Int     @default(0)
  hoursWorked Decimal @default(0) @db.Decimal(6, 1)
  totalPay    Decimal @default(0) @db.Decimal(10, 2)

  updatedAt   DateTime @updatedAt

  @@unique([userId, year, month])
  @@index([userId])
}